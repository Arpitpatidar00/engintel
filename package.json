{
  "name": "engintel-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "EngIntel: engineering intelligence and architecture gate for JS/TS repositories.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test && pnpm run test:workspace",
    "test:workspace": "node --test scripts/workspace-policy.test.mjs",
    "golden:update": "turbo run build --filter=@engintel/testkit --output-logs=errors-only && node packages/testkit/dist/bin/update-golden-manifest.js"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
