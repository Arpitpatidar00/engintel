{
  "name": "@engintel/orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Validation orchestrator: runs adapters, normalizes diagnostics, applies fail-closed policy.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@engintel/config": "workspace:*",
    "@engintel/graph": "workspace:*",
    "@engintel/policy": "workspace:*",
    "@engintel/scanner": "workspace:*",
    "@engintel/symbols": "workspace:*"
  },
  "devDependencies": {
    "@engintel/testkit": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
