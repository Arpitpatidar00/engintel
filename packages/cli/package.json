{
  "name": "@engintel/cli",
  "version": "0.1.0",
  "private": true,
  "description": "The engintel command-line interface. Same binary for developers and CI.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "engintel": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@engintel/config": "workspace:*",
    "@engintel/orchestrator": "workspace:*",
    "commander": "catalog:"
  },
  "devDependencies": {
    "@engintel/testkit": "workspace:*",
    "@types/node": "catalog:",
    "@types/sarif": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
